# Modelo de configuração. Não coloque valores reais neste arquivo.
# O programa lê estas variáveis do ambiente do terminal; ele não carrega o arquivo .env sozinho.
# Veja no README como defini-las.

# Endereço base do servidor Ollama (sem /api/chat no final).
OLLAMA_URL=https://exemplo.invalido

# Nome do modelo disponível nesse servidor.
OLLAMA_MODELO=nome-do-modelo
